# Скопируйте в .env и подставьте свой ключ OpenAI
OPENAI_API_KEY=

# Необязательно: где хранить данные (относительный путь — от корня репозитория).
# Без этих строк данные лежат внутри репозитория, как в нём и поставляются.
# DOCUMENTS_DATA_DIR=graphs/structured_documents/data   # PDF документов и извлечённое из них
# SERVICE_DATA_DIR=graphs/rag_agent/data                 # кэши индексов, фоновые задачи, сессии чата
